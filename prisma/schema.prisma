generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  MECHANIC
  WHOLESALE
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING_PARTNER
}

enum ProductCondition {
  NEW
  STOCK
  REFURBISHED
  ORIGINAL
  AFTERMARKET
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  PACKAGING
  SHIPPED
  DELIVERED
  CANCELED
  AWAITING_RETURN
  RETURNED
  AWAITING_WARRANTY
  REFUNDED
  INCOMPLETE
  AWAITING_PARTNER_APPROVAL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELED
  REFUNDED
}

enum CouponType {
  PERCENT
  FIXED
}

enum StockMovementType {
  IN
  OUT
  ADJUST
  RETURN
  DAMAGED
}

enum QuoteStatus {
  NEW
  ANSWERED
  CLOSED
}

enum PartnerType {
  MECHANIC
  WHOLESALE
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  RECEIVED
  REPAIRING
  REPLACED
  REFUNDED
}

model User {
  id            String     @id @default(cuid())
  phone         String     @unique
  name          String?
  email         String?
  nationalCode  String?
  role          UserRole   @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  walletBalance Int        @default(0)
  loyaltyPoints Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  addresses      Address[]
  vehicles       UserVehicle[]
  orders         Order[]
  carts          Cart[]
  reviews        Review[]
  questions      Question[]
  wishlistItems  WishlistItem[]
  quoteRequests  QuoteRequest[]
  partnerRequest PartnerRequest[]
  returnRequests ReturnRequest[]
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  title        String?
  province     String
  city         String
  postalCode   String?
  addressLine  String
  plaque       String?
  unit         String?
  receiverName String
  receiverPhone String
  isDefault    Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VehicleMake {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  logo  String?
  order Int    @default(0)

  models  VehicleModel[]
  compat  Compatibility[]
  garages UserVehicle[]
}

model VehicleModel {
  id     String @id @default(cuid())
  makeId String
  name   String
  slug   String

  make    VehicleMake     @relation(fields: [makeId], references: [id], onDelete: Cascade)
  trims   VehicleTrim[]
  compat  Compatibility[]
  garages UserVehicle[]

  @@unique([makeId, slug])
  @@index([makeId])
}

model VehicleTrim {
  id           String  @id @default(cuid())
  modelId      String
  name         String
  yearFrom     Int
  yearTo       Int?
  engine       String?
  fuel         String?
  transmission String?

  model  VehicleModel    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  compat Compatibility[]
  garage UserVehicle[]

  @@index([modelId])
}

model UserVehicle {
  id      String  @id @default(cuid())
  userId  String
  makeId  String
  modelId String
  trimId  String
  year    Int?
  plate   String?
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  make  VehicleMake  @relation(fields: [makeId], references: [id])
  model VehicleModel @relation(fields: [modelId], references: [id])
  trim  VehicleTrim  @relation(fields: [trimId], references: [id])

  @@index([userId])
}

model Category {
  id       String     @id @default(cuid())
  parentId String?
  name     String
  slug     String     @unique
  icon     String?
  order    Int        @default(0)
  isActive Boolean    @default(true)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Brand {
  id         String  @id @default(cuid())
  name       String  @unique
  slug       String  @unique
  logo       String?
  country    String?
  isOriginal Boolean @default(false)

  products Product[]
}

model Product {
  id             String           @id @default(cuid())
  slug           String           @unique
  name           String
  technicalCode  String?
  partNumber     String?
  oemNumber      String?
  condition      ProductCondition @default(NEW)
  categoryId     String
  brandId        String
  warrantyMonths Int              @default(0)
  warrantyTerms  String?
  weightGrams    Int?
  country        String?
  shortDesc      String?
  longDesc       String?
  specs          String?
  price          Int
  partnerPrice   Int?
  discountPrice  Int?
  discountEndsAt DateTime?
  stock          Int              @default(0)
  lowStockAt     Int              @default(3)
  minOrderQty    Int              @default(1)
  maxOrderQty    Int?
  status         ProductStatus    @default(ACTIVE)
  isFeatured     Boolean          @default(false)
  isNew          Boolean          @default(false)
  isBestSeller   Boolean          @default(false)
  hasFreeShipping Boolean         @default(false)
  ratingAvg      Float            @default(0)
  ratingCount    Int              @default(0)
  salesCount     Int              @default(0)
  viewCount      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  category    Category        @relation(fields: [categoryId], references: [id])
  brand       Brand           @relation(fields: [brandId], references: [id])
  images      ProductImage[]
  tiers       PriceTier[]
  crossRefs   CrossRef[]
  compat      Compatibility[]
  reviews     Review[]
  questions   Question[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  wishlist    WishlistItem[]
  stockMoves  StockMovement[]
  quoteItems  QuoteItem[]

  @@index([categoryId, status])
  @@index([brandId])
  @@index([partNumber])
  @@index([oemNumber])
  @@index([technicalCode])
  @@index([isBestSeller, status])
  @@index([createdAt])
}

model PriceTier {
  id        String @id @default(cuid())
  productId String
  minQty    Int
  price     Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, minQty])
  @@index([productId])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  alt       String?
  order     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model CrossRef {
  id        String @id @default(cuid())
  productId String
  code      String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([code])
}

model Compatibility {
  id        String  @id @default(cuid())
  productId String
  makeId    String
  modelId   String
  trimId    String?
  yearFrom  Int?
  yearTo    Int?
  note      String?

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  make    VehicleMake  @relation(fields: [makeId], references: [id])
  model   VehicleModel @relation(fields: [modelId], references: [id])
  trim    VehicleTrim? @relation(fields: [trimId], references: [id])

  @@index([productId])
  @@index([trimId])
  @@index([modelId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  title     String?
  body      String
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([productId, isApproved])
}

model Question {
  id        String    @id @default(cuid())
  productId String
  userId    String
  body      String
  answer    String?
  answeredAt DateTime?
  createdAt DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Cart {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?
  couponCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id])
  items CartItem[]

  @@index([userId])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  qty       Int
  unitPrice Int

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model ShippingMethod {
  id        String  @id @default(cuid())
  name      String
  cost      Int
  freeAbove Int?
  etaDays   String?
  isActive  Boolean @default(true)
  order     Int     @default(0)
}

model Order {
  id          String      @id @default(cuid())
  code        String      @unique
  userId      String?
  status      OrderStatus @default(PENDING_PAYMENT)
  subtotal    Int
  discount    Int         @default(0)
  shippingCost Int        @default(0)
  tax         Int         @default(0)
  total       Int
  couponCode  String?
  shippingMethod String?
  province    String
  city        String
  addressLine String
  postalCode  String?
  receiverName String
  receiverPhone String
  note        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user         User?                @relation(fields: [userId], references: [id])
  items        OrderItem[]
  statusHistory OrderStatusHistory[]
  payments     Payment[]
  returns      ReturnRequest[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  name      String
  qty       Int
  unitPrice Int
  total     Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model OrderStatusHistory {
  id      String      @id @default(cuid())
  orderId String
  status  OrderStatus
  note    String?
  createdAt DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id       String        @id @default(cuid())
  orderId  String
  gateway  String
  amount   Int
  status   PaymentStatus @default(PENDING)
  authority String?
  refId    String?
  createdAt DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique
  type         CouponType
  value        Int
  minSubtotal  Int?
  maxDiscount  Int?
  usageLimit   Int?
  usedCount    Int        @default(0)
  startsAt     DateTime?
  endsAt       DateTime?
  isActive     Boolean    @default(true)
}

model QuoteRequest {
  id        String      @id @default(cuid())
  userId    String?
  name      String
  phone     String
  message   String?
  status    QuoteStatus @default(NEW)
  answer    String?
  createdAt DateTime    @default(now())

  user  User?       @relation(fields: [userId], references: [id])
  items QuoteItem[]
}

model QuoteItem {
  id        String  @id @default(cuid())
  quoteId   String
  productId String?
  name      String
  qty       Int

  quote   QuoteRequest @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product?     @relation(fields: [productId], references: [id])
}

model PartnerRequest {
  id       String      @id @default(cuid())
  userId   String
  type     PartnerType
  shopName String
  city     String
  message  String?
  status   String      @default("PENDING")
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ReturnRequest {
  id          String       @id @default(cuid())
  orderId     String
  userId      String
  reason      String
  description String?
  status      ReturnStatus @default(PENDING)
  createdAt   DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([orderId])
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String
  type      StockMovementType
  qty       Int
  note      String?
  userId    String?
  createdAt DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Settings {
  key   String @id
  value String
}

model SmsLog {
  id        String   @id @default(cuid())
  phone     String
  template  String
  body      String
  status    String   @default("SENT")
  createdAt DateTime @default(now())

  @@index([phone])
}

model SearchLog {
  id          String   @id @default(cuid())
  query       String
  resultCount Int
  userId      String?
  createdAt   DateTime @default(now())

  @@index([query])
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  body        String
  cover       String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}
